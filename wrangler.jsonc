/**
 * Cloudflare Workers deployment.
 * Builds the Next.js dashboard in /web (static export to /web/out)
 * and serves it through an explicit fetch handler that delegates to
 * the ASSETS binding.
 *
 * Docs: https://developers.cloudflare.com/workers/static-assets/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goldorg",
  "compatibility_date": "2025-04-01",
  "main": "./worker.js",
  "build": {
    "command": "cd web && npm install && npm run build"
  },
  "assets": {
    "directory": "./web/out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
